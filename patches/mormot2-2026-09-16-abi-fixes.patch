diff --git a/src/core/mormot.core.interfaces.pas b/src/core/mormot.core.interfaces.pas
index b456cc4..f042685 100644
--- a/src/core/mormot.core.interfaces.pas
+++ b/src/core/mormot.core.interfaces.pas
@@ -7096,10 +7096,9 @@ load_regs:
    cmp  x15, imvDouble
    b.eq float_result
    cmp  x15, imvDateTime
-   b.eq float_result
-   cmp  x15, imvCurrency
    b.ne asmcall_end
-   // store double result in res64
+   // AArch64 returns Currency as its scaled Int64 value in x0
+   // store only floating-point results from d0
 float_result:
    str  d0, [x19, #TCallMethodArgs.res64]
 asmcall_end:
@@ -7196,8 +7195,15 @@ asm
         mov     cl, [r12].TCallMethodArgs.resKind
         cmp     cl, imvDouble
         je      @d
-        cmp     cl, imvDateTime // but imvCurrency is returned in rax
+        cmp     cl, imvDateTime
+        je      @d
+        {$if defined(FPC) and defined(OSPOSIX)}
+        // FPC SysV x64 returns Currency through x87 ST0, unlike Win64/RAX
+        cmp     cl, imvCurrency
         jne     @e
+        fistp   qword [r12].TCallMethodArgs.res64
+        {$endif}
+        jmp     @e
 @d:     movlpd  qword ptr [r12].TCallMethodArgs.res64, xmm0
         // movlpd to ignore upper 64-bit of 128-bit xmm0 reg
 @e:     {$ifdef FPC}

diff --git a/src/lib/mormot.lib.quickjs.pas b/src/lib/mormot.lib.quickjs.pas
